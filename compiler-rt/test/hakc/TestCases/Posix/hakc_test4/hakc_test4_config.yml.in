Arch:                 X86
Platform:             Test
DatabasePath:         @PWD@/hakc-db
SourcePath:           @PWD@
BuildPath:            @PWD@/build
DagAnalysisRootPath:  @PWD@/dag_analysis
OutputDebugInfo:      true
PassMode:             @PASS_MODE@
IncludePaths:         []
#CustomTransferFunctions:
#  - { type: "char *", name: "hakc_transfer_string", ptr-idx: 0, compartment-idx: 1, division-idx: 2 }
#  - { type: "struct sk_buff*", name: "hakc_transfer_skb", ptr-idx: 0, compartment-idx: 1, division-idx: 2 }
#  - { type: "const struct nlattr * const", name: "hakc_transfer_nla", ptr-idx: 0, compartment-idx: 2, division-idx: 3, size-idx: 1 }
#  - { type: "struct file *", name: "hakc_transfer_file_struct", ptr-idx: 0, compartment-idx: 1, division-idx: 2 }
#  - { type: "struct socket *", name: "hakc_transfer_socket", ptr-idx: 0, compartment-idx: 1, division-idx: 2 }
CodeValidationFunction: "check_hakc_code_access"
DataValidationFunction: "check_hakc_data_access"
SignWithDivisionFunction: { name: "hakc_sign_pointer_with_color", ptr-idx: 0, compartment-idx: 1, is-code-idx: 2 }
DefaultCompartmentTransferFunction: { name: "hakc_transfer_to_clique", ptr-idx: 0, size-idx: 1, compartment-idx: 2, division-idx: 3 }
#PerCPUCompartmentTransferFunction: { name: "hakc_transfer_percpu_to_clique", ptr-idx: 0, size-idx: 1, compartment-idx: 2, division-idx: 3 }
CompartmentalizationSupportFunctions:
  - { name: "get_hakc_color_by_name" }
  - { name: "get_hakc_percpu_color", ptr-idx: 0 }
  - { name: "get_hakc_address_color", ptr-idx: 0}
  - { name: "hakc_sign_pointer_with_color", ptr-idx: 0, compartment-idx: 1 }
  - { name: "hakc_sign_pcpu_pointer_with_color", ptr-idx: 0, compartment-idx: 1 }
  - { name: "hakc_sign_pointer", ptr-idx: 0, compartment-idx: 1, division-idx: 2 }
  - { name: "hakc_color_address", ptr-idx: 0, division-idx: 1, size-idx: 2 }
