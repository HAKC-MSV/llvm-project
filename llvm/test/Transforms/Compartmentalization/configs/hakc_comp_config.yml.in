Arch: X86
Platform: Test
Database:
  server-url: @PWD@/hakc-socket
  get-compartment-by-id-endpoint: "get-compartment-by-id"
  get-division-by-id-endpoint: "get-division-by-id"
  get-division-from-symbol-endpoint: "get-division-from-symbol"
  get-valid-targets-from-compartment-id-endpoint: "get-valid-targets-from-compartment-id"
SourcePath: @PWD@
BuildPath: @PWD@/build
DagAnalysisRootPath: @PWD@/dag_analysis
OutputDebugInfo: true
PassMode: @PASS_MODE@
IncludePaths: [ ]
PreTransferActions:
  - { type: "i32 (ptr)", name: "get_hakc_address_color", args: [ { idx: 0, label: __hakc_step_0__ } ] }
PostTargetActions:
  - { type: "void (ptr, i32, i64)", name: "hakc_color_address", args: [ { idx: 2, label: __hakc_step_0__ } ] }
CustomTransferFunctions:
  - { type: "char *", name: "hakc_transfer_string", ptr-idx: 0, compartment-idx: 1, division-idx: 2 }
  - { type: "struct sk_buff*", name: "hakc_transfer_skb", ptr-idx: 0, compartment-idx: 1, division-idx: 2 }
  - { type: "const struct nlattr * const", name: "hakc_transfer_nla", ptr-idx: 0, compartment-idx: 2, division-idx: 3, size-idx: 1 }
  - { type: "struct file *", name: "hakc_transfer_file_struct", ptr-idx: 0, compartment-idx: 1, division-idx: 2 }
  - { type: "struct socket *", name: "hakc_transfer_socket", ptr-idx: 0, compartment-idx: 1, division-idx: 2 }
CodeValidationFunction: { type: "ptr (ptr, i64, i64, ptr, i64)", name: "check_hakc_code_access", params: [ { idx: 0, name: address }, { idx: 1, name: compartment }, { idx: 2, name: access_token }, { idx: 3, name: valid_targets }, { idx: 4, name: n_targets } ] }
DataValidationFunction: { type: "ptr (ptr, i64, i64)", name: "check_hakc_data_access", params: [ { idx: 0, name: address }, { idx: 1, name: compartment }, { idx: 2, name: access_token } ] }
SignWithDivisionFunction: { type: "ptr (ptr, i32, i1)", name: "hakc_sign_pointer_with_color", params: [ { idx: 0, name: address }, { idx: 1, name: compartment }, { idx: 2, name: is_code } ] }
DefaultCompartmentTransferFunction: { type: "ptr (ptr, i64, i64, i64, i1)", name: "hakc_transfer_to_clique", params: [ { idx: 0, name: address }, { idx: 1, name: size }, { idx: 2, name: compartment }, { idx: 3, name: division }, { idx: 4, name: is_code } ] }
PerCPUCompartmentTransferFunction: { type: "ptr (ptr, i64, i64, i64)", name: "hakc_transfer_percpu_to_clique", params: [ { idx: 0, name: address }, { idx: 1, name: size }, { idx: 2, name: compartment }, { idx: 3, name: division } ] }
CompartmentalizationSupportFunctions:
  - { type: "i32 (i32)", name: "get_hakc_color_by_name", params: [ { idx: 0, name: color_name } ] }
  - { type: "i32 (ptr)", name: "get_hakc_percpu_color", params: [ { idx: 0, name: address } ] }
  - { type: "i32 (ptr)", name: "get_hakc_address_color", params: [ { idx: 0, name: address } ] }
  - { type: "ptr (ptr, i64, i1)", name: "hakc_sign_pointer_with_color", params: [ { idx: 0, name: address }, { idx: 1, name: compartment }, { idx: 2, name: is_code } ] }
  - { type: "ptr (ptr, i64)", name: "hakc_sign_pcpu_pointer_with_color", params: [ { idx: 0, name: address }, { idx: 1, name: compartment } ] }
  - { type: "ptr (ptr, i64, i64, i1)", name: "hakc_sign_pointer", params: [ { idx: 0, name: address }, { idx: 1, name: compartment }, { idx: 2, name: division }, { idx: 3, name: is_code } ] }
  - { type: "void (ptr, i64, i64)", name: "hakc_color_address", params: [ { idx: 0, name: address }, { idx: 1, name: division }, { idx: 2, name: is_code } ] }
IgnoredTypes: ["struct list_head", "struct proto", "struct atomic64_s", "struct atomic_s"]
