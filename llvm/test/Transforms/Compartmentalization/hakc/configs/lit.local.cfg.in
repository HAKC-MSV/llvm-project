config.name = "@TestName@-@HAKC_BACKING_TYPE@"
config.test_source_root = "@HAKC_TEST_DIR@"

config.substitutions.append(("%HAKC_START_POLICY_SERVER",
                             "python3 @HAKC_PYTHON_POLICY_PROCESS@ --config @HAKC_POLICY_CONFIG@ --log-level %LOG_LEVEL"))
config.substitutions.append(("%HAKC_CONFIG",            "@HAKC_PASS_CONFIG@"))
config.substitutions.append(("%HAKC_EVALUATE",          "cat %t.out.ll | FileCheck %s || exit 1"))
config.substitutions.append(("%LOG_LEVEL",              "ERROR"))
config.substitutions.append(("%hakc_clang",             "@CMAKE_BINARY_DIR@/llvm-project/llvm/bin/clang"))

config.suffixes = [".c", ".cpp"]
