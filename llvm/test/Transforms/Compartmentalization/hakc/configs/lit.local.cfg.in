config.name = "@TestName@-@HAKC_BACKING_TYPE@"
config.test_source_root = "@HAKC_TEST_DIR@"

config.substitutions.append(("%HAKC_START_POLICY_SERVER",
                             f'rm -f @HAKC_SOCKET_PATH@ && touch @HAKC_SOCKET_PATH@ && eval \"python @HAKC_PYTHON_POLICY_PROCESS@ --config @HAKC_SERVER_CONFIG@ -l @HAKC_BUILD_DIR@/policy-server.log --log-level %LOG_LEVEL &\"'))
config.substitutions.append(("%HAKC_START_ANALYSIS_SERVER", f'rm -f @HAKC_SOCKET_PATH@ && touch @HAKC_SOCKET_PATH@ && eval \"python @HAKC_PYTHON_ANALYSIS_SERVER_PROCESS@ --config @HAKC_SERVER_CONFIG@ -l @HAKC_BUILD_DIR@/analysis-server.log --log-level %LOG_LEVEL &\"'))
config.substitutions.append(("%HAKC_EVALUATE", "cat %t | FileCheck %s || exit 1"))
config.substitutions.append(("%LOG_LEVEL", "ERROR"))
config.substitutions.append(("%HAKC_PYTHON_VENV", "source @HAKC_PYTHON_VENV@/bin/activate"))
config.substitutions.append(
    ("%HAKC_RUN_COMP_PASS",
     "clang -O0 -g -S -emit-llvm -mllvm --enable-hakc -mllvm --hakc-config=@HAKC_PASS_CONFIG@ -o %t %s "))
config.substitutions.append(
    ("%HAKC_RUN_ANALYSIS_PASS",
     "clang -O0 -g -S -emit-llvm -mllvm --enable-hakc -mllvm --hakc-config=@HAKC_PASS_CONFIG@ -o %t %s "))

config.suffixes = [".c", ".cpp"]
