def spin_up_local_reduce_procs(config, server_gather_buckets, local_reduce_procs_completed, global_reduce_bucket):
    global local_reduce_procs
    local_reduce_procs = {local_reduce_id: mp.Process(target= launch_reduce_proc,
                                                      args= (local_reduce_id, server_gather_buckets, local_reduce_procs_completed, global_reduce_bucket,),
                                                      name= f"local reduce  {f'{local_reduce_id}'.zfill(2)}") for local_reduce_id in range(config.max_server_processes)}
    [proc.start() for _, proc in local_reduce_procs.items()]

def join_local_reduce_procs():
    global local_reduce_procs
    [proc.join() for _, proc in local_reduce_procs.items()]

def spin_up_global_reduce_proc(comp, local_reduce_done, global_reduce_bucket):
    global global_reduce_proc
    global_reduce_proc = {0: mp.Process(target=launch_global_reduce_proc,
                                                     args=(comp, local_reduce_done, global_reduce_bucket,),
                                                     name=f"global reduce")}
    [proc.start() for _, proc in global_reduce_proc.items()]

def join_global_reduce_proc():
    global global_reduce_proc
    [proc.join() for _, proc in global_reduce_proc.items()]

def spin_up_server_gather_procs(config, server_gather_buckets, server_gather_procs_completed, server_mode, ServerMainLogger):
    global server_gather_procs
    server_gather_procs = {server_id: mp.Process(target= launch_server_gather_proc,
                                                 args= (server_id, server_gather_buckets, server_gather_procs_completed, config, server_mode, ServerMainLogger,),
                                                 name= f"gather server { f'{server_id}'.zfill(2) }") for server_id in range(config.max_server_processes)}
    [proc.start() for _, proc in server_gather_procs.items()]

def join_server_gather_procs():
    global server_gather_procs
    [proc.join() for _, proc in server_gather_procs.items()]

def spin_up_progress_bars(server_gather_procs_completed, local_reduce_procs_completed, max_server_processes):
    global progress_bars_proc
    progress_bars_proc = mp.Process(target= launch_progress_bars, args=(server_gather_procs_completed,local_reduce_procs_completed, max_server_processes,), name= f"progress bars proc")
    progress_bars_proc.start()

def join_progress_bars():
    global progress_bars_proc
    progress_bars_proc.kill()
    progress_bars_proc.join()

def launch_progress_bars(server_gather_procs_completed, local_reduce_procs_completed, max_server_processes):

    server_gather_procs_completed_pbar = logger.progress_bar(total=max_server_processes, desc='Server Gather Processes Completed', position=0)
    local_reduce_procs_completed_pbar = logger.progress_bar(total=max_server_processes, desc='Local Reduce Processes Completed', position=1)

    while True:
        if server_gather_procs_completed.value > 0:
            server_gather_procs_completed_pbar.update(1)
            server_gather_procs_completed.value -= 1
        if local_reduce_procs_completed.value > 0:
            local_reduce_procs_completed_pbar.update(1)
            local_reduce_procs_completed.value -= 1
        time.sleep(1)

# noinspection PyTypeChecker
def main():
    parser = argparse.ArgumentParser(description='HAKC Analysis Server Process')
    parser.add_argument('--profile', dest='profile', action='store_true')
    parser.add_argument('--log-mode', default='w', dest='log_mode')
    parser.add_argument('--config', help='Path to server config file', required=True)
    parser.add_argument('--log-level', required=False, dest='log_level',
                        help=f'Log level to display, can be lower case {[level.name for level in LoggingLevelEnum]}',
                        type=parse_log_level, default=LoggingLevelEnum.INFO,)
    parser.add_argument('--server-mode', dest='server_mode', help=f'Server mode can be {[mode.name for mode in HAKCServerMode]}',
                        type=parse_server_mode, default=HAKCServerMode.ANALYSIS)
    args = parser.parse_args()

    # setting up root logger, which all other loggers should inherit its properties (unless we overwrite them later)
    # need to set up server logger here, or else all the initialization stuff will happen without debugging
    # loggers that are used in the data_source files need to be initialized BEFORE the init_data_source function is called
    config = None
    profile = None

    with open(args.config, 'r') as f:
        parsed_config = yaml.safe_load(f)
        config = HAKCServerConfig(**parsed_config)

    analysis_mode = args.server_mode == HAKCServerMode.ANALYSIS
    policy_mode = not analysis_mode
    config.server_timeout = config.analysis_config.timeout if analysis_mode else config.policy_config.timeout

    root_logger = logging.getLogger()
    setup_logging(root_logger, log_level=args.log_level if args.log_level else config.log_level, log_file=config.log_path if config.log_path else '', log_mode=args.log_mode)

    ServerMainLogger: HAKCLogger = cast(HAKCLogger, logging.getLogger('hakc-server-main'))
    if config.log_path:
        ServerMainLogger.add_file_handler(config.log_path)

    if args.profile:
        profile = cProfile.Profile()
        profile.enable()

    # Spawn mp manager to share resources amongst processes
    with mp.Manager() as manager:
        server_gather_procs_completed: mp.Value = mp.Value('i', 0)
        local_reduce_procs_completed: mp.Value = mp.Value('i', 0)
        # initialize shared data structures
        # contains queues for each add-symbols resulting compartmentalization
        server_gather_buckets = manager.dict({server_id: manager.Queue() for server_id in range(config.max_server_processes)})

        spin_up_progress_bars(server_gather_procs_completed, local_reduce_procs_completed, config.max_server_processes)
        if policy_mode:
            spin_up_server_gather_procs(config, server_gather_buckets, server_gather_procs_completed, args.server_mode, ServerMainLogger)
            join_server_gather_procs()

        elif analysis_mode:
            # Note: need to wrap compartmentalization object in a process safe structure or value will not update correctly
            comp = manager.Queue()
            local_reduce_done = manager.Event()
            global_reduce_bucket = manager.Queue()

            spin_up_server_gather_procs(config, server_gather_buckets, server_gather_procs_completed, args.server_mode, ServerMainLogger)
            spin_up_local_reduce_procs(config, server_gather_buckets, local_reduce_procs_completed, global_reduce_bucket)
            # launch final merger to combine all the compartmentalizations from other mergers
            spin_up_global_reduce_proc(comp, local_reduce_done, global_reduce_bucket)

            join_server_gather_procs()
            join_local_reduce_procs()

            # only send 'done' signal once all the local reductions finish
            local_reduce_done.set()
            join_global_reduce_proc()

            compartmentalization = comp.get()

            logger.debug(f"Deleting old db at {config.database_path}")
            compartmentalization.delete_db(config.database_path)
            logger.debug(f"Opening new db at {config.database_path}")
            # Note: creating new database creates a conn which must be closed manually later
            compartmentalization.create_new_db(config.database_path)

            # Note: an open database connection is required to add default compartmentalization or create dag
            logger.debug(f"Adding default compartmentalization at {config.database_path}")
            compartmentalization.add_default_compartmentalization(config.database_path)
            logger.debug(f"Constructing DAG from {compartmentalization} at {config.database_path}")
            compartmentalization.create_dag(config.analysis_config.max_dag_processes, config.database_path)

            logger.debug(f"Finished constructing {compartmentalization}")

            if config.analysis_config.adjustments_path:
                compartmentalization.adjust_compartmentalization(config.analysis_config.adjustments_path, config.database_path)
            compartmentalization.close_conn()
        join_progress_bars()
    if args.profile:
        profile.disable()
        output_profile_stats(profile)

if __name__ == "__main__":

    def signal_handler(sig, frame):
        # print("\nCtrl+C detected via signal handler. Exiting.")
        # Perform cleanup here
        cleanup_processes()

        sys.exit(0)

    signal.signal(signal.SIGINT, signal_handler)

    main()
