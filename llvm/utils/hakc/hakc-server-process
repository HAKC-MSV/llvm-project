logger = cast(HAKCLogger, logging.getLogger('hakc-server-process'))

server_gather_procs: dict[int, mp.Process] = {}
local_reduce_procs: dict[int, mp.Process] = {}
global_reduce_proc: dict[int, mp.Process] = {} # size 1
progress_bars_proc: Optional[mp.Process] = None

def timeout_handler(signum, frame):
    raise TimeoutException

def parse_server_mode(server_mode: str) -> HAKCServerMode:
    for mode in HAKCServerMode:
        if mode.name == server_mode.upper() or mode.name == server_mode.lower():
            return mode
    raise RuntimeError(f'Invalid server mode {server_mode}')

def output_profile_stats(profile):
    s = io.StringIO()
    ps = pstats.Stats(profile, stream=s).sort_stats('tottime')
    ps.print_stats()
    logger.info(s.getvalue())

def launch_global_reduce_proc(comp, local_reduce_done, global_reduce_bucket):
    # import traceback
    logger.debug(f"Spinning up global reduce process!")
    compartmentalization = HAKCCompartmentalization()

    while True:
        # queue must be empty before thread can exit
        try:
            subG = global_reduce_bucket.get(block=False, timeout=1)
            if subG:
                if len(compartmentalization) == 0:
                    logger.debug(f"Starting global reduce")
                compartmentalization.update(edges=subG.edges(data=True, keys=True),
                                            nodes=subG.nodes(data=True))
                logger.debug(f"global reduce {compartmentalization}")
        except Empty:
            time.sleep(0.1)
            if local_reduce_done.is_set():
                assert len(compartmentalization) > 0
                assert global_reduce_bucket.empty()
                logger.debug(f"Finished global reduce!")
                comp.put(compartmentalization)
                return
        except Exception as e:
            # traceback.print_exc()
            logger.fatal(f"global reduce got an exception: {e}")
            raise e

def launch_reduce_proc(reduce_id: int, server_gather_buckets, local_reduce_procs_completed, global_reduce_bucket):
    logger.debug(f"Spinning up reduce process {reduce_id}!")
    local_reduce_compartmentalization = HAKCCompartmentalization()

    while True:
        # if all threads have been gathered
        # TODO: maybe do some if interchange here
        try:
            subG = server_gather_buckets[reduce_id].get(block=False)
            # logger.error(f"Got subG: {subG}")
            # Note: is not subG equal to subG is None?
            if subG is None:
                # logger.error(f"subG is None")
                assert(len(local_reduce_compartmentalization) > 0)
                assert(server_gather_buckets[reduce_id].empty())
                logger.debug(f"\t\tFinished local reduce {local_reduce_compartmentalization}")
                global_reduce_bucket.put(local_reduce_compartmentalization)
                local_reduce_procs_completed.value += 1
                return
            if len(local_reduce_compartmentalization) == 0:
                logger.debug(f"\tStarting local reduce")
            local_reduce_compartmentalization.update(edges=subG.edges(data=True, keys=True),
                                                     nodes=subG.nodes(data=True))
            logger.debug(f"\t{local_reduce_compartmentalization}")
        except Empty:
            time.sleep(0.1)
        except Exception as e:
            logger.fatal(f"local reduce error: {e}")
            raise e

def launch_server_gather_proc(server_id: int, server_gather_buckets, server_gather_procs_completed: mp.Value, config: HAKCServerConfig, server_mode: HAKCServerMode, ServerMainLogger: logger):
    config.socket_path = Path(os.path.join(config.socket_path, str(server_id)))
    logger.debug(f"Spinning up server gather process {server_id}!")
    if config.reuse_path and config.socket_path.exists():
        config.socket_path.unlink()

    with HAKCServer(server_id, server_gather_buckets, config, server_mode, ServerMainLogger) as server:
        try:
            if config.server_timeout > 0:
                signal.signal(signal.SIGALRM, timeout_handler)
                signal.alarm(config.server_timeout)
            server.serve_forever()
        except TimeoutException:
            server_gather_buckets[server_id].put(None)
            server_gather_procs_completed.value += 1
            ServerMainLogger.debug(f'Finished gathering')
        except Exception as e:
            ServerMainLogger.error(f'Server received generic Exception: {e}')
        finally:
            server.server_close()

