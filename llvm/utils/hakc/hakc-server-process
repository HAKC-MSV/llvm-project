mp_conn: HAKCDatabase | None = None


def init_mp_database(db_dir: str):
    global mp_conn
    mp_conn = HAKCDatabase(db_dir, read_only=True)


def output_profile_stats(profile, logger_to_use: HAKCLogger):
    s = io.StringIO()
    ps = pstats.Stats(profile, stream=s).sort_stats('tottime')
    ps.print_stats()
    logger_to_use.info(s.getvalue())


def add_argument_to_command_list(cmd: list[str], arg_name: str, arg_value: Optional[str] = None,
                                 add_mllvm: bool = True):
    full_argument = f'{arg_name}={arg_value}' if arg_value is not None else f'{arg_name}'

    argument_already_in_cmd = arg_name in " ".join(cmd)

    if argument_already_in_cmd:
        for i in range(len(cmd)):
            cmd_token = shlex.quote(cmd[i])
            if arg_name in cmd_token:
                cmd[i] = full_argument
                break
    else:
        if add_mllvm:
            cmd.insert(len(cmd) - 1, '-mllvm')
        for arg_tok in full_argument.split(" "):
            cmd.insert(len(cmd) - 1, arg_tok)


def run_compilation_target(database_entry: dict, logger_to_use: HAKCLogger, socket_path: str, config_path: str,
                           output_ir: bool, pass_mode: str):
    cmd: list[str] = list()
    if 'command' in database_entry:
        cmd = shlex.split(database_entry['command'])
    if 'arguments' in database_entry:
        cmd = database_entry['arguments']

    output_file_name = None

    if 'output' in database_entry:
        output_file_name = database_entry['output']
    else:
        for i in range(len(cmd)):
            if cmd[i] == '-o':
                output_file_name = cmd[i + 1]
                break

    skip_compile_task = output_file_name is None or not output_file_name.endswith('.o')
    if skip_compile_task:
        return

    add_argument_to_command_list(cmd, f'-enable-hakc')

    add_argument_to_command_list(cmd, '--hakc-config', config_path)

    add_argument_to_command_list(cmd, f'--hakc-server-path', socket_path)

    add_argument_to_command_list(cmd, f'--pass-mode', pass_mode)

    if output_ir:
        add_argument_to_command_list(cmd, '-S -emit-llvm', add_mllvm=False)
        for i in range(len(cmd)):
            if cmd[i] == '-o':
                base, _ = os.path.splitext(cmd[i + 1])
                cmd[i + 1] = base + ".ll"
                break

    cwd = database_entry["directory"]
    logger_to_use.debug(f'Running {" ".join(cmd)} from {cwd}')

    subprocess.run(cmd, text=True, check=True, stderr=subprocess.STDOUT, stdout=subprocess.PIPE, cwd=cwd)


def safe_serve_forever(server, logger_to_use):
    try:
        server.serve_forever()
    except Exception as e:
        logger_to_use.error(f'Server ended: {e}')


def start_hakc_server(server_id: int, server_mode: HAKCBuildMode, config: HAKCConfig, logger_to_use: HAKCLogger) -> \
        Tuple[HAKCServer, threading.Thread]:
    logger_to_use.debug(f'Starting server in {server_mode.value} mode')
    server = HAKCServer(server_id=server_id, server_mode=server_mode, config=config, logger_to_use=logger_to_use)
    server_thread = threading.Thread(target=safe_serve_forever, args=(server, logger_to_use))
    server_thread.start()
    return server, server_thread


def get_error_log_dir_path(config: HAKCConfig, server_mode: HAKCBuildMode):
    return os.path.join(config.log_dir, 'error-logs', server_mode.value)


def do_compilation_task(database_entry: dict, logger_to_use: HAKCLogger, server: HAKCServer):
    compilation_file = database_entry['file']
    try:
        run_compilation_target(database_entry, logger_to_use, str(server.socket_path),
                               str(server.config.root_config_path), server.server_mode.output_ir,
                               'analysis' if server.server_mode.is_analysis_mode else 'enforcement')
        logger_to_use.debug(f'Compilation task completed')
        return True
    except subprocess.CalledProcessError as e:
        err_file = os.path.join(get_error_log_dir_path(server.config, server.server_mode),
                                os.path.basename(compilation_file) + "." + str(int(time.time())) + ".err")
        os.makedirs(os.path.dirname(err_file), exist_ok=True)
        with open(err_file, 'w') as f:
            logger_to_use.error(f'Failed to compile {compilation_file}. Output logged to {err_file}')
            print(f'Command: {" ".join(e.cmd)}', file=f)
            print(f'Directory: {database_entry["directory"]}', file=f)
            print(e.stdout, file=f)
        return False


def make_worker_logger(name: str, task_id: int, log_level: LoggingLevelEnum) -> logging.Logger:
    logger = logging.getLogger(name)
    logger.setLevel(log_level.value)
    logger.propagate = False

    # remove any existing handlers to avoid duplicates on re-entry
    for h in list(logger.handlers):
        logger.removeHandler(h)

    h = logging.StreamHandler(sys.stderr)
    fmt = logging.Formatter(f'%(asctime)s [%(processName)s, %(threadName)s] [%(levelname)s] Task {task_id} %(message)s')
    h.setFormatter(fmt)
    logger.addHandler(h)
    return logger


class HAKCCompilationAgent:
    def __init__(self, server_mode: HAKCBuildMode, config: HAKCConfig):
        self.agent_id = os.getpid()
        self.config = config
        self.server_mode = server_mode
        self.logger = cast(HAKCLogger,
                           make_worker_logger(f'hakc.server-worker-{self.agent_id}', self.agent_id, config.log_level))
        self.server, self.server_thread = start_hakc_server(self.agent_id, self.server_mode, self.config, self.logger)

    def stop(self):
        if not self.server_thread.is_alive():
            return

        try:
            self.server.shutdown()
        except Exception as e:
            self.logger.error(f'Failed to shutdown server: {e}')

        try:
            self.server.server_close()
        except Exception as e:
            self.logger.error(f'Failed to close server: {e}')

        try:
            self.server_thread.join(timeout=1.0)
        except Exception as e:
            self.logger.error(f'Failed to join server thread: {e}')

    def __del__(self):
        self.stop()


agent: Optional[HAKCCompilationAgent] = None


def stop_compilation_agent():
    global agent
    if agent is not None:
        agent.stop()


def create_logger_and_start_server(server_mode: HAKCBuildMode, config: HAKCConfig):
    global agent
    agent = HAKCCompilationAgent(server_mode, config)


def compile_database_entry(database_entry: dict):
    global agent
    if not do_compilation_task(database_entry, agent.logger, agent.server):
        raise RuntimeError(f'Failed to compile {database_entry["file"]}')


def merge_two_compartmentalizations(a_graph: HAKCCompartmentalization, b_graph: HAKCCompartmentalization):
    if len(a_graph) > len(b_graph):
        small_graph = b_graph
        large_graph = a_graph
    else:
        small_graph = a_graph
        large_graph = b_graph

    large_graph.update(edges=small_graph.edges(data=True, keys=True),
                       nodes=small_graph.nodes(data=True))
    return large_graph


def analyze_one_entry(database_entry: dict):
    global agent
    agent.server.compartmentalization = HAKCCompartmentalization()
    compile_database_entry(database_entry)
    return agent.server.compartmentalization


def shutdown_server():
    global agent
    if agent is None:
        return
    try:
        agent.logger.debug(f'Shutting down server at {agent.server.socket_path}')
        stop_compilation_agent()
    except Exception as e:
        # Log but don't propagate - we want all workers to attempt shutdown
        if agent and agent.logger:
            agent.logger.error(f"Error during shutdown: {e}")


def get_batched_compilation_entries(compilation_database: dict, batch_size: int, file_set: set[str]):
    files = list()
    for db_entry in compilation_database:
        if os.path.exists(db_entry['file']):
            if len(file_set) > 0 and db_entry['file'] not in file_set:
                continue
            files.append(db_entry)

    for batched_compilation_entries in batched(files, batch_size):
        yield batched_compilation_entries


def get_worker_count(core_count: int):
    return max(1, core_count // 2)


def create_enforcement_obj_files(compilation_database: dict, batch_size: int, config: HAKCConfig,
                                 server_main_logger: HAKCLogger, server_mode: HAKCBuildMode, file_set: set[str]):
    assert server_mode.is_enforcement_mode
    worker_count = get_worker_count(config.server_config.analysis_core_count)
    successful_enforcement = True
    with cf.ProcessPoolExecutor(max_workers=worker_count, initializer=create_logger_and_start_server,
                                initargs=(server_mode, config)) as executor:
        futures = dict()
        task_id = 0
        for batched_compilation_entries in get_batched_compilation_entries(compilation_database, batch_size, file_set):
            for database_entry in batched_compilation_entries:
                future = executor.submit(compile_database_entry, database_entry)
                futures[future] = task_id
                task_id += 1

        with server_main_logger.progress_bar(desc="Generating hardened object files", total=len(futures)) as pbar:
            for future in cf.as_completed(futures):
                pbar.update(1)
                try:
                    task_id = futures[future]
                    future.result()
                except Exception as e:
                    successful_enforcement = False
                    server_main_logger.error(f'Error in task {task_id}: {e}')

        futures = dict()
        for worker in range(worker_count):
            futures[executor.submit(shutdown_server)] = worker

        with server_main_logger.progress_bar(desc="Shutting down servers", total=len(futures)) as pbar:
            for future in cf.as_completed(futures):
                pbar.update(1)
                try:
                    worker_id = futures[future]
                    future.result()
                except Exception as e:
                    server_main_logger.error(f'Error shutting down {worker_id}: {e}')

        executor.shutdown(wait=False)

    if not successful_enforcement:
        server_main_logger.error(f'Failed to successfully add enforcement. Quitting')
        sys.exit(1)


def perform_analysis_with_compilation_database(config: HAKCConfig, compilation_database: dict, batch_size: int,
                                               server_main_logger: HAKCLogger, server_mode: HAKCBuildMode,
                                               file_set: set[str]) -> Optional[
    HAKCCompartmentalization]:
    assert server_mode.is_analysis_mode
    db_dir = config.server_config.backing_config.path if config.server_config.backing_config.type == HAKCBackingType.KUZU else ''

    worker_count = get_worker_count(config.server_config.analysis_core_count)
    ready = deque()  # graphs ready to be merged
    analyze_futures = set()
    merge_futures = set()
    successful_creation = True

    # Create both pools at the same time so merge can run while analysis continues.
    with cf.ProcessPoolExecutor(
            max_workers=worker_count,
            initializer=create_logger_and_start_server,
            initargs=(server_mode, config),
    ) as analyze_pool, cf.ProcessPoolExecutor(
        max_workers=config.server_config.analysis_core_count
    ) as merge_pool:
        # Submit all analysis work (or you can make this incremental; see note below)
        for batched_entries in get_batched_compilation_entries(
                compilation_database, batch_size, file_set
        ):
            for database_entry in batched_entries:
                analyze_futures.add(analyze_pool.submit(analyze_one_entry, database_entry))

        total_analyze = len(analyze_futures)
        # Upper bound on merges is N-1
        total_merge = max(0, total_analyze - 1)

        with server_main_logger.progress_bar(desc="Analyzing", total=total_analyze) as p_an, \
                server_main_logger.progress_bar(desc="Merging", total=total_merge) as p_mg:

            # Helper: schedule merges while possible (and while we have merge worker capacity)
            def schedule_merges():
                while len(ready) >= 2:
                    a = ready.pop()
                    b = ready.pop()
                    merge_futures.add(merge_pool.submit(merge_two_compartmentalizations, a, b))

            # Initial attempt (probably no-op at start)
            schedule_merges()

            # Drive both sets of futures until everything is reduced
            while analyze_futures or merge_futures:
                # If we can schedule merges from already-ready graphs, do it.
                schedule_merges()

                # Choose what to wait on:
                # - if there are analysis futures, always include them
                # - include merge futures too so we can keep reduction moving
                wait_set = set()
                if analyze_futures:
                    wait_set |= analyze_futures
                if merge_futures:
                    wait_set |= merge_futures

                done, _ = cf.wait(wait_set, return_when=cf.FIRST_COMPLETED)

                for fut in done:
                    if fut in analyze_futures:
                        analyze_futures.remove(fut)
                        p_an.update(1)
                        try:
                            g = fut.result()
                            ready.append(g)
                        except Exception as e:
                            successful_creation = False
                            server_main_logger.error(f"Error analyzing entry: {e}")
                    else:
                        merge_futures.remove(fut)
                        p_mg.update(1)
                        try:
                            g = fut.result()
                            ready.append(g)
                        except Exception as e:
                            successful_creation = False
                            server_main_logger.error(f"Error merging compartmentalization: {e}")

            if not ready:
                raise RuntimeError("No graph produced (all tasks failed?)")

            while len(ready) > 1:
                a = ready.pop()
                b = ready.pop()
                merged = merge_two_compartmentalizations(a, b)
                ready.append(merged)

            compartmentalization = ready.pop()

        # Now shut down servers (analysis pool is still alive here; submit shutdown tasks to it)
        shutdown_futs = [analyze_pool.submit(shutdown_server) for _ in range(worker_count)]
        with server_main_logger.progress_bar(desc="Shutting down servers", total=len(shutdown_futs)) as pbar:
            for fut in cf.as_completed(shutdown_futs):
                pbar.update(1)
                try:
                    fut.result()
                except Exception as e:
                    server_main_logger.error(f"Error shutting down server: {e}")

    if not successful_creation:
        server_main_logger.error("Completed with errors.")
        return None

    compartmentalization.db_dir = db_dir
    return compartmentalization


def create_dag(config: HAKCConfig, compilation_database: dict, logger_to_use: HAKCLogger, batch_size: int,
               server_mode: HAKCBuildMode, files_to_compile: set[str]):
    start = time.time()
    compartmentalization = perform_analysis_with_compilation_database(config, compilation_database, batch_size,
                                                                      logger_to_use, server_mode, files_to_compile)
    if compartmentalization is None:
        logger_to_use.error(f'Failed to create compartmentalization. Exiting.')
        sys.exit(1)

    if server_mode.output_ir:
        logger_to_use.info(f'Stopping because mode is IR Output mode')
        sys.exit(0)

    match config.server_config.backing_config.type:
        case HAKCBackingType.KUZU:
            compartmentalization.delete_db()
            # Note: manually opening a connection requires manual closure later
            compartmentalization.open_conn()
        case HAKCBackingType.YAML:
            sys.exit(1)

        # Note: an open database connection is required to add default compartmentalization or create dag
    logger_to_use.info(f'{compartmentalization} was created')
    compartmentalization.add_default_compartmentalization(create_schema=True)
    compartmentalization.create_dag(config.server_config.analysis_core_count)

    if config.server_config.adjustments:
        compartmentalization.perform_adjustments(config.server_config.adjustments)

    compartmentalization.close_conn()
    if len(compartmentalization) == 0:
        raise RuntimeError(f'Created an empty compartmentalization')

    end = time.time()
    logger_to_use.info(f'Finished constructing DAG {compartmentalization}')
    logger_to_use.info(f'    Total Time: {end - start} seconds')


# noinspection PyTypeChecker
def main():
    parser = argparse.ArgumentParser(description='HAKC Server Process')
    parser.add_argument('--config', help='Path to server config file', required=True)
    parser.add_argument('--mode', help=f'Mode to start the HAKC server in ({[e.value for e in HAKCBuildMode]})',
                        required=True, type=HAKCBuildMode.from_str)
    parser.add_argument('--batch-size', help='Number of tasks to submit to processes', type=int, dest='batch_size',
                        default=100)
    parser.add_argument('files_to_compile', nargs='*', help='List of files to compile')

    args = parser.parse_args()

    # setting up root logger, which all other loggers should inherit its properties (unless we overwrite them later)
    # need to set up server logger here, or else all the initialization stuff will happen without debugging
    # loggers that are used in the data_source files need to be initialized BEFORE the init_data_source function is called
    profile = None

    server_mode = args.mode

    with open(args.config, 'r') as f:
        config_inputs = yaml.safe_load(f)
        config_inputs['root-file-path'] = args.config

        config = HAKCConfig(**config_inputs)

    if os.path.exists(get_error_log_dir_path(config, server_mode)):
        shutil.rmtree(get_error_log_dir_path(config, server_mode))

    with open(config.server_config.compilation_database, 'r') as f:
        compilation_database = json.load(f)

    server_main_logger: HAKCLogger = cast(HAKCLogger, logging.getLogger('hakc.server-main'))
    setup_logging(server_main_logger, log_level=config.log_level,
                  log_file=os.path.join(config.log_dir, "hakc.server." + server_mode.value + ".log"),
                  log_mode=config.server_config.log_mode)

    if config.server_config.profile:
        profile = cProfile.Profile()
        profile.enable()

    file_set = set(args.files_to_compile)

    if server_mode.is_analysis_mode:
        create_dag(config, compilation_database, server_main_logger, args.batch_size, server_mode, file_set)
    elif server_mode.is_enforcement_mode:
        create_enforcement_obj_files(compilation_database, args.batch_size, config, server_main_logger, server_mode,
                                     file_set)

    if config.server_config.profile:
        profile.disable()
        output_profile_stats(profile, server_main_logger)


if __name__ == "__main__":
    main()
