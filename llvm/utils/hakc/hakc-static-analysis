def get_node_dag_connections(conn, symbol_hash, Name):
    cmd = f"""
        MATCH p = (head:HAKCSymbol)-[:DagEdge*1..2]->(tail:HAKCSymbol)
        WHERE head.symbol_hash=$symbol_hash
        RETURN DISTINCT properties(nodes(p), 'Name') as Name, properties(rels(p), '_src') as src
    """
    response = conn.execute_prepared_stmt(cmd, symbol_hash=symbol_hash)
    ret = response.get_as_df()
    G = nx.DiGraph()
    G.add_node(Name)
    # then add each tail as a connection
    for path in ret["Name"]:
        for node in path:
            if node not in G:
                G.add_node(node)
        nx.add_path(G, path)

    # go and remove nodes with .str in them
    nodes_to_remove = [node for node in G.nodes if ".str" in node]
    G.remove_nodes_from(nodes_to_remove)
    return G

def get_symbol_hash(conn, Name, DefiningFile, DefiningLine):
    cmd = f"""
        MATCH (sym:HAKCSymbol)
        WHERE sym.Name=$Name AND sym.DefiningFile=$DefiningFile AND sym.DefiningLine=$DefiningLine
        RETURN DISTINCT sym.symbol_hash
    """
    response = conn.execute_prepared_stmt(cmd, Name=Name, DefiningFile=DefiningFile, DefiningLine=DefiningLine)
    hash = response.get_as_df()["sym.symbol_hash"][0]
    print(f"Queried symbol hash: {hash} from (Name, DefiningFile, DefiningLine) = ({Name}, {DefiningFile}, {DefiningLine})")
    return int(hash)

