arch:                   X86
platform:               Linux
timeout:                @hakc_client_timeout@
console-log-level:      Error
file-log-level:         Debug
max-connection-retries: @hakc_max_connection_retries@
PreTargetActions:
  - { name: "get_hakc_address_color", label: "saved-color" }
PostTargetActions:
  - { name: "hakc_color_address", arguments: [ { idx: 2, label: "saved-color" } ] }
CustomTransferFunctions:
  - transfer-obj-type: "char *"
    name: hakc_transfer_string
    return-type: ptr
    arguments:
      - { idx: 0, type: ptr, arg-use: signed-ptr }
      - { idx: 1, type: i64, arg-use: compartment }
      - { idx: 2, type: i64, arg-use: division }
  - transfer-obj-type: "char []"
    name: hakc_transfer_string
    return-type: ptr
    arguments:
      - { idx: 0, type: ptr, arg-use: signed-ptr }
      - { idx: 1, type: i64, arg-use: compartment }
      - { idx: 2, type: i64, arg-use: division }
  - transfer-obj-type: "struct sk_buff *"
    name: hakc_transfer_skb
    return-type: ptr
    arguments:
      - { idx: 0, type: ptr, arg-use: signed-ptr }
      - { idx: 1, type: i64, arg-use: compartment }
      - { idx: 2, type: i64, arg-use: division }
  - transfer-obj-type: "struct nlattr *"
    name: hakc_transfer_nla
    return-type: ptr
    arguments:
      - { idx: 0, type: ptr, arg-use: signed-ptr }
      - { idx: 1, type: i64, arg-use: compartment }
      - { idx: 2, type: i64, arg-use: division }
  - transfer-obj-type: "struct file *"
    name: hakc_transfer_file_struct
    return-type: ptr
    arguments:
      - { idx: 0, type: ptr, arg-use: signed-ptr }
      - { idx: 1, type: i64, arg-use: compartment }
      - { idx: 2, type: i64, arg-use: division }
  - transfer-obj-type: "struct socket *"
    name: hakc_transfer_socket
    return-type: ptr
    arguments:
      - { idx: 0, type: ptr, arg-use: signed-ptr }
      - { idx: 1, type: i64, arg-use: compartment }
      - { idx: 2, type: i64, arg-use: division }
CodeValidationFunction:
  return-type: ptr
  name: check_hakc_code_access
  arguments:
    - { idx: 0, type: ptr, arg-use: signed-ptr }
    - { idx: 1, type: i64, arg-use: compartment }
    - { idx: 2, type: i64, arg-use: access-token }
    - { idx: 3, type: ptr, arg-use: valid-targets }
    - { idx: 4, type: i64, arg-use: valid-target-size }
DataValidationFunction:
  return-type: ptr
  name: check_hakc_data_access
  arguments:
    - { idx: 0, type: ptr, arg-use: signed-ptr }
    - { idx: 1, type: i64, arg-use: compartment }
    - { idx: 2, type: i64, arg-use: access-token }
SignWithDivisionFunction:
  return-type: ptr
  name: hakc_sign_pointer_with_color
  arguments:
    - { idx: 0, type: ptr, arg-use: signed-ptr }
    - { idx: 1, type: i64, arg-use: compartment }
    - { idx: 2, type: i1, arg-use: is-code }
DefaultCompartmentTransferFunction:
  return-type: ptr
  name: hakc_transfer_to_clique
  arguments:
    - { idx: 0, type: ptr, arg-use: signed-ptr }
    - { idx: 1, type: i64, arg-use: size }
    - { idx: 2, type: i64, arg-use: compartment }
    - { idx: 3, type: i64, arg-use: division }
    - { idx: 4, type: i1, arg-use: is-code }
PerCPUCompartmentTransferFunction:
  return-type: ptr
  name: hakc_transfer_percpu_to_clique
  arguments:
    - { idx: 0, type: ptr, arg-use: signed-ptr }
    - { idx: 1, type: i64, arg-use: size }
    - { idx: 2, type: i64, arg-use: compartment }
    - { idx: 3, type: i64, arg-use: division }
CompartmentalizationSupportFunctions:
  - return-type: void
    name: hakc_color_address
    arguments:
      - { idx: 0, type: ptr, arg-use: signed-ptr }
      - { idx: 1, type: i64, arg-use: division }
      - { idx: 2, type: i64, arg-use: size }
  - return-type: i32
    name: get_hakc_color_by_name
    arguments:
      - { idx: 0, type: ptr, arg-use: other }
  - return-type: i32
    name: get_hakc_percpu_color
    arguments:
      - { idx: 0, type: ptr, arg-use: signed-ptr }
  - return-type: i32
    name: get_hakc_address_color
    arguments:
      - { idx: 0, type: ptr, arg-use: signed-ptr }
  - return-type: ptr
    name: hakc_sign_pointer_with_color
    arguments:
      - { idx: 0, type: ptr, arg-use: signed-ptr }
      - { idx: 1, type: i64, arg-use: compartment }
      - { idx: 2, type: i1, arg-use: is-code }
  - return-type: ptr
    name: hakc_sign_pcpu_pointer_with_color
    arguments:
      - { idx: 0, type: ptr, arg-use: signed-ptr }
      - { idx: 1, type: i64, arg-use: compartment }
      - { idx: 2, type: i1, arg-use: is-code }
  - return-type: ptr
    name: hakc_sign_pointer
    arguments:
      - { idx: 0, type: ptr, arg-use: signed-ptr }
      - { idx: 1, type: i64, arg-use: compartment }
      - { idx: 2, type: i1, arg-use: is-code }
IgnoredTypes: [ "struct list_head", "struct proto", "struct atomic64_s", "struct atomic_s" ]
NoTransferFunctions:
  - { name: "clear_page_orig" }
  - { name: "clear_page_rep" }
  - { name: "clear_page_erms" }
  - { name: "copy_user_generic_unrolled" }
  - { name: "copy_user_generic_string" }
  - { name: "copy_user_enhanced_fast_string" }
  - { name: "asm_sysvec_xen_hvm_callback" }
  - { name: "sha256_transform_avx" }
  - { name: "sha256_transform_ssse3" }
  - { name: "sha256_transform_avx" }
  - { name: "sha256_transform_rorx" }
  - { name: "sha256_ni_transform" }
  - { name: "__bpf_call_base" }
  - { name: "ftrace_stub" }
  - { name: "ftrace_stub_graph" }
  - { name: "ftrace_call" }
  - { name: "parse_memtest" }
  - { name: "__stack_chk_fail" }
  - { name: "is_vmalloc_addr" }
  - { name: "page_to_phys" }
  - { name: "vmalloc_to_page" }
  - { name: "virt_to_pfn" }
  - { name: "cleanup_module" }
  - { name: "raid6_int4_xor_syndrome" }
  - { name: "raid6_int1_gen_syndrome" }
  - { name: "raid6_int2_xor_syndrome" }
  - { name: "raid6_int8_gen_syndrome" }
  - { name: "raid6_int4_gen_syndrome" }
  - { name: "raid6_int2_gen_syndrome" }
  - { name: "raid6_int8_xor_syndrome" }
  - { name: "raid6_int1_xor_syndrome" }
SeparateNamespacePaths:
  - { path_root: arch/x86/kernel/, file_names: [ idt.c, irq.c, ftrace.c, machine_kexec_64.c, module.c, x86_init.c, pci-swiotlb.c, paravirt.c, kvm.c, signal_64.c, signal.c ] }
  - { path_root: arch/x86/kernel/acpi, file_names: [ boot.c ] }
  - { path_root: arch/x86/kernel/cpu, file_names: [ vmware.c ] }
  - { path_root: arch/x86/kvm/, file_names: [ emulate.c, x86.c ] }
  - { path_root: arch/x86/net/, file_names: [ bpf_jit_comp.c ] }
  - { path_root: arch/x86/xen/, file_names: [ apic.c, efi.c, enlighten_hvm.c, enlighten.c, enlighten_pv.c, grant-table.c, irq.c, mmu_hvm.c , mmu.c , mmu_pv.c , multicalls.c , p2m.c , pci-swiotlb-xen.c , platform-pci-unplug.c , pmu.c , setup.c , smp_hvm.c , smp.c , smp_pv.c , suspend_hvm.c , suspend.c , suspend_pv.c , time.c , trace.c , vga.c , xen-asm.c ] }
  - { path_root: drivers/firmware/efi/libstub/, file_names: [ fdt.c ] }
  - { path_root: fs/, file_names: [ readdir.c ] }
  - { path_root: kernel/, file_names: [ rseq.c ] }
  - { path_root: kernel/entry/, file_names: [ common.c ] }
  - { path_root: lib/, file_names: [ idr.c, xarray.c ] }
  - { path_root: mm/, file_names: [ maccess.c, gup.c ] }
  - { path_root: net/core/, file_names: [ scm.c, filter.c ] }
HAKCSourcePaths:
  - { path_root: arch/x86/kernel/hakc/, file_names: [ hakc_ni.c, hakc.c, hakc_btree.c, hakc_memory.c ] }
  - { path_root: drivers/usb/storage/, file_names: [ transfer.c ] }
  - { path_root: fs/fuse/, file_names: [ transfer.c ] }
  - { path_root: kernel/hakc/, file_names: [ hakc_common.c, hakc_noarch_tag_btree.c, hakc_noarch_tag_memory.c, hakc_global_init.c ] }
SafeTransitionFunctions:
  - { name: "kmemdup" }
  - { name: "__memcpy" }
  - { name: "__pi_memcmp" }
  - { name: "__pi_strcmp" }
  - { name: "bcmp" }
  - { name: "__arch_copy_from_user" }
  - { name: "__memset" }
  - { name: "memchr_inv" }
  - { name: "__arch_copy_to_user" }
  - { name: "xas_load" }
  - { name: "xas_find_marked" }
  - { name: "xa_head" }
  - { name: "crc32_le" }
  - { name: "__crc32c_le" }
  - { name: "cpu_switch_to" }
  - { name: "__pi_clear_page" }
  - { name: "clear_page" }
  - { name: "__clear_page" }
  - { name: "__pi_copy_page" }
  - { name: "copy_page" }
  - { name: "__copy_page" }
  - { name: "__pi_memchr" }
  - { name: "memchr" }
  - { name: "__memchr" }
  - { name: "__pi_memcpy" }
  - { name: "memcpy" }
  - { name: "__memcpy" }
  - { name: "__pi_memmove" }
  - { name: "memmove" }
  - { name: "__memmove" }
  - { name: "__pi_memset" }
  - { name: "memset" }
  - { name: "__memset" }
  - { name: "__pi_strlen" }
  - { name: "strlen" }
  - { name: "memcmp" }
  - { name: "strcmp" }
  - { name: "memchr" }
  - { name: "strchr" }
  - { name: "__strlen" }
  - { name: "__pi_strncmp" }
  - { name: "strncmp" }
  - { name: "__strncmp" }
  - { name: "__pi_strnlen" }
  - { name: "strnlen" }
  - { name: "__strnlen" }
  - { name: "__pi_strrchr" }
  - { name: "strrchr" }
  - { name: "__strrchr" }
  - { name: "__arch_clear_user" }
  - { name: "__ashlti3" }
  - { name: "__ashrti3" }
  - { name: "__lshrti3" }
IgnoredGlobals:
  - { name: kmalloc_caches }
AllocationFunctions:
  - { name: kmalloc, type: SimpleArgumentSize, arguments: [ 0 ] }
  - { name: kzalloc, type: SimpleArgumentSize, arguments: [ 0 ] }
  - { name: __kmalloc, type: SimpleArgumentSize, arguments: [ 0 ] }
  - { name: neigh_parms_alloc, type: SimpleStaticSize, arguments: [ 144 ] }
  - { name: nlmsg_new, type: StaticPlusArgument, arguments: [ 64,0 ] }
  - { name: kmemdup, type: SimpleArgumentSize, arguments: [ 1 ] }
  - { name: __alloc_percpu, type: SimpleArgumentSize, arguments: [ 0 ] }
  - { name: __alloc_percpu_gfp, type: SimpleArgumentSize, arguments: [ 0 ] }
  - { name: kmalloc_array, type: MultiplyTwoArguments, arguments: [ 0,1 ] }
  - { name: kcalloc, type: MultiplyTwoArguments, arguments: [ 0,1 ] }
  - { name: sk_alloc, type: SimpleStaticSize, arguments: [ 64 ] }
  - { name: __alloc_skb, type: SimpleArgumentSize, arguments: [ 0 ] }
  - { name: kmem_cache_zalloc, type: SimpleArgumentSize, arguments: [ 0 ] }
  - { name: nla_memdup, type: SimpleStaticSize, arguments: [ 64 ] }
  - { name: kzalloc_node, type: SimpleArgumentSize, arguments: [ 0 ] }
  - { name: fib_rules_register, type: SimpleStaticSize, arguments: [ 256 ] }
  - { name: nla_strdup, type: SimpleStaticSize, arguments: [ 64 ] }
  - { name: kvmalloc, type: SimpleArgumentSize, arguments: [ 0 ] }
  - { name: kvmalloc_array, type: MultiplyTwoArguments, arguments: [ 0,1 ] }
  - { name: kvzalloc, type: SimpleArgumentSize, arguments: [ 0 ] }
  - { name: kmem_cache_alloc, type: ArgumentGEP, arguments: [ 0,1 ] }
  - { name: kmem_cache_alloc_trace, type: SimpleArgumentSize, arguments: [ 2 ] }
  - { name: create_workqueue, type: SimpleStaticSize, arguments: [ 320 ] }
  - { name: device_create, type: SimpleStaticSize, arguments: [ 768 ] }
  - { name: __class_create, type: SimpleStaticSize, arguments: [ 120 ] }
